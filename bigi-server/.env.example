# Copy this file to .env and fill in real values. Never commit .env.

# Resend (https://resend.com) — used to send magic-link logins and
# "new supplier profile created" notifications.
RESEND_API_KEY=

# The email address magic links / notifications are sent FROM.
# Must be a verified sender/domain in your Resend account.
# Resend's shared test domain works for local development:
EMAIL_FROM=Bigi Admin <onboarding@resend.dev>

# Comma-separated whitelist — only these emails may access the hidden admin area.
ADMIN_EMAILS=daniel.dsse4@gmail.com,gormoevents@gmail.com

# Random long string used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Supabase (https://supabase.com) — permanent storage for supplier profiles,
# photos and admin logins. Leave both empty to use local files (development).
# Dashboard → Project Settings → API Keys: use a *secret* key (sb_secret_...).
# The secret key is server-only: never put it in the website's browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public base URL of this server. Magic links and supplier-profile links
# are built from this. Update it once the site is actually deployed.
BASE_URL=http://localhost:3000

PORT=3000
